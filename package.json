{
  "name": "titancore-mirror",
  "version": "1.0.0",
  "description": "Reverse proxy mirror for shop-titancore.com (Shopify)",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/index.js",
    "start": "node src/index.js",
    "build:checkout": "node scripts/build-checkout-from-scrape.mjs",
    "step:1": "node scripts/step1-static-shell.mjs",
    "step:2": "node scripts/step2-replace-card-iframes.mjs",
    "test": "node scripts/test-proxy-rewrite.mjs && node scripts/test-checkout-intercept.mjs && node scripts/test-checkout-layout.mjs && node scripts/test-ws-smoke.mjs",
    "test:passthrough": "node scripts/test-checkout-passthrough.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^4.21.0",
    "http-proxy-middleware": "^3.0.0"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "puppeteer": "^24.0.0"
  }
}
